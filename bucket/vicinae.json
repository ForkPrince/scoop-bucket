{
    "version": "0.29.2",
    "description": "A focused launcher for your desktop - native, fast, extensible",
    "homepage": "https://vicinae.com",
    "license": "GPL-3.0-only",
    "notes": [
        "On arm64 the binaries are a community build from https://github.com/ForkPrince/vicinae/releases. They are unsigned, which disables Vicinae's built-in updater on that architecture, so use 'scoop update vicinae' instead.",
        "Extensions need a Node.js runtime, which Vicinae downloads from nodejs.org on first use into %LOCALAPPDATA%\\vicinae\\data\\node."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/vicinaehq/vicinae/releases/download/v0.29.2/vicinae-x64-portable.zip",
            "hash": "8bf37efa99d3abbbe63215a75fe3681ab0ce81a9db96d56ccc4264b42e82c97c"
        },
        "arm64": {
            "url": "https://github.com/ForkPrince/vicinae/releases/download/v0.29.2/vicinae-arm64-portable.zip",
            "hash": "1391a61ccc9ede326d7c711606c532fe0313cb14ae11d1c33084ffde850da814"
        }
    },
    "bin": [
        "bin\\vicinae.exe",
        "bin\\vicinae-server.exe"
    ],
    "shortcuts": [
        [
            "bin\\vicinae-server.exe",
            "Vicinae"
        ]
    ],
    "checkver": {
        "github": "https://github.com/vicinaehq/vicinae"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/vicinaehq/vicinae/releases/download/v$version/vicinae-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/ForkPrince/vicinae/releases/download/v$version/vicinae-arm64-portable.zip",
                "hash": {
                    "url": "https://github.com/ForkPrince/vicinae/releases/download/v$version/SHA256SUMS",
                    "regex": "(?m)^([a-fA-F0-9]{64})[\\x20]+[*]?vicinae-arm64-portable\\.zip"
                }
            }
        }
    }
}
